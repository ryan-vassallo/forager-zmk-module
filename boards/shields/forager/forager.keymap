#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define BASE  0
#define BT    1
#define NUM   2
#define NAV   3
#define MOUSE 4

/ {
    macros {
        qq: type_two_qs {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <20>;
            tap-ms = <20>;
            bindings = <&macro_tap &kp Q &kp Q>;
        };
    };

    behaviors {
        lhm: left_homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions =
                <5 6 7 8 9 15 16 17 18 19
                 25 26 27 28 29 30 31 32 33>;
            hold-trigger-on-release;
        };

        rhm: right_homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions =
                <0 1 2 3 4 10 11 12 13 14
                 20 21 22 23 24 30 31 32 33>;
            hold-trigger-on-release;
        };

        // generic hold-tap: first param = hold, second = tap
        kth: key_tap_hold {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;
        };

        // hold-tap for dance internals
        dance_ht: dance_hold_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <0>;
            bindings = <&kp>, <&kp>;
        };

        // NUM row1 col1:
        // single tap -> F1
        // double tap -> GRAVE
        f1_grave_td: f1_grave_tap_dance {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <220>;
            bindings = <&kp F1>, <&kp GRAVE>;
        };

        // Base Q tap dance:
        // single tap -> Q
        // double tap -> QQ
        // double-tap-hold -> ESC
        q_double: q_double_hold_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <0>;
            bindings = <&kp>, <&qq>;
        };

        q_dance: q_tap_dance {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <220>;
            bindings = <&kp Q>, <&q_double ESC 0>;
        };

        // Base semicolon tap dance:
        // single tap -> SEMI
        // hold -> RGUI
        // double tap -> SQT
        semi_dance: semicolon_tap_dance {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <220>;
            bindings = <&dance_ht RGUI SEMI>, <&kp SQT>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            display-name = "Base";
            bindings = <
                &q_dance      &kp W         &kp E         &kp R         &kp T
                &kp Y         &kp U         &kp I         &kp O         &kp P

                &lhm LGUI A   &lhm LALT S   &lhm LCTRL D  &lhm LSHFT F  &kp G
                &kp H         &rhm RSHFT J  &rhm RCTRL K  &rhm RALT L   &semi_dance

                &kp Z         &kp X         &kp C         &kp V         &kp B
                &kp N         &kp M         &kp COMMA     &kth HASH DOT &kth BSLH FSLH

                &lt NUM TAB   &mo BT        &lt MOUSE BSPC &lt NAV SPACE
            >;
        };

        bt {
            display-name = "Bluetooth";
            bindings = <
                &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
                &bt BT_PRV    &bt BT_NXT    &none         &none         &none

                &none         &none         &none         &none         &out OUT_USB
                &out OUT_USB  &out OUT_BLE  &none         &none         &none

                &none         &none         &none         &none         &none
                &none         &none         &none         &bt BT_CLR    &bt BT_CLR_ALL

                &trans        &trans        &kp ENTER     &trans
            >;
        };

        numbers {
            display-name = "Numbers";
            bindings = <
                &f1_grave_td  &kp F2        &kp F3        &kp F4        &kp F5
                &kp N7        &kp N8        &kp N9        &kp EQUAL     &kp MINUS

                &kp F6        &kp F7        &kp F8        &kp F9        &kp F10
                &kp N4        &kp N5        &kp N6        &kp LBKT      &kp RBKT

                &kp TILDE     &kp PIPE      &trans        &kp F11       &kp F12
                &kp N1        &kp N2        &kp N3        &kp DOT       &kp DELETE

                &trans        &trans        &trans        &kp N0
            >;
        };

        navigation {
            display-name = "Navigation";
            bindings = <
                &trans        &trans        &kp C_MUTE      &kp C_VOL_DN    &kp C_VOL_UP
                &kp PG_UP     &kp HOME      &kp UP          &kp END         &trans

                &kp LGUI      &kp LALT      &kp LCTRL       &kp LSHFT       &trans
                &kp PG_DN     &kp LEFT      &kp DOWN        &kp RIGHT       &trans

                &trans        &kp C_PREV    &kp C_NEXT      &kp C_STOP      &kp C_PP
                &trans        &kp LC(LS(TAB)) &kp LC(TAB)   &trans          &trans

                &trans        &trans        &trans          &trans
            >;
        };

        mouse {
            display-name = "Mouse";
            bindings = <
                &trans         &trans          &mkp LCLK       &mkp MCLK        &mkp RCLK
                &trans         &trans          &mmv MOVE_UP    &trans           &trans

                &trans         &trans          &msc SCRL_LEFT  &msc SCRL_UP     &msc SCRL_RIGHT
                &trans         &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &trans

                &trans         &trans          &trans          &msc SCRL_DOWN   &trans
                &trans         &trans          &trans          &trans           &trans

                &trans         &trans          &trans          &trans
            >;
        };
    };
};

&lt {
    tapping-term-ms = <200>;
};
